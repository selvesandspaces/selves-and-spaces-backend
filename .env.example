SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Public publishable key (sb_publishable_...); used only to verify the current password on password change.
SUPABASE_PUBLISHABLE_KEY=
ENVIRONMENT=development
REQUIRE_CONFIRMED_EMAIL=false

# Razorpay: dummy (no keys, local fake) | test (rzp_test_ keys) | live (rzp_live_ keys)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Any string you choose; the same value goes in Razorpay Dashboard > Webhooks > Secret.
RAZORPAY_WEBHOOK_SECRET=
